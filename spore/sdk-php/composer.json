{
    "name": "lalternative/spore",
    "version": "0.1.0",
    "description": "Control plane for the Spore transactional email platform.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://sporee.fr/docs/sdks/php",
    "license": "proprietary",
    "authors": [
        {
            "name": "Spore",
            "homepage": "https://sporee.fr"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "Lalternative\\Spore\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "Lalternative\\Spore\\Test\\" : "test/" }
    }
}
