{
  "name": "@lalternative/meet",
  "version": "0.1.0",
  "description": "Video call UI for L'Alternative apps on LiveKit: several speakers, several screens per speaker, grid / stage / screens layouts and a stage pinned for everyone",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "peerDependencies": {
    "@livekit/components-react": "^2.9.0",
    "livekit-client": "^2.20.1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@livekit/components-react": "^2.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "livekit-client": "^2.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "video",
    "webrtc",
    "livekit",
    "visio"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lalternative/packages.git",
    "directory": "meet"
  },
  "sideEffects": [
    "*.css"
  ]
}
