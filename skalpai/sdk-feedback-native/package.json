{
  "name": "@lalternative/skalpai-feedback-native",
  "version": "0.1.0",
  "description": "Skalpai feedback widget for React Native and Expo (iOS, Android)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./expo-image-picker": {
      "types": "./dist/expo-image-picker.d.ts",
      "import": "./dist/expo-image-picker.js"
    },
    "./view-shot": {
      "types": "./dist/view-shot.d.ts",
      "import": "./dist/view-shot.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "expo-image-picker": ">=16",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-safe-area-context": ">=4",
    "react-native-view-shot": ">=3"
  },
  "peerDependenciesMeta": {
    "expo-image-picker": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "expo-image-picker": "~17.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-view-shot": "4.0.3",
    "tsup": "^8.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "skalpai",
    "feedback",
    "react-native",
    "expo",
    "ios",
    "android"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lalternative/packages.git",
    "directory": "skalpai/sdk-feedback-native"
  }
}
