{
  "name": "@lalternative/lalter-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for lalter's app-key-facing API (tasks, chat), generated from OpenAPI 3.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lalternativefabrique/packages.git",
    "directory": "lalter/sdk-node"
  },
  "scripts": {
    "filter-openapi": "node scripts/filter-openapi.mjs openapi.full.json openapi.json",
    "generate": "pnpm run filter-openapi && orval --config orval.config.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "orval": "^7.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
