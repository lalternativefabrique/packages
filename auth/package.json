{
  "name": "@lalternative/auth",
  "version": "2.3.0",
  "description": "The suite's sign-in on urbangate for L'Alternative apps: the product's server routes, the browser and Expo clients, and the auth UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./urbangate": {
      "import": "./dist/urbangate.js",
      "types": "./dist/urbangate.d.ts"
    },
    "./urbangate-client": {
      "import": "./dist/urbangate-client.js",
      "types": "./dist/urbangate-client.d.ts"
    },
    "./urbangate-native": {
      "import": "./dist/urbangate-native.js",
      "types": "./dist/urbangate-native.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "playground": "vite --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vite": "^7.1.7"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lalternative/packages.git",
    "directory": "auth"
  },
  "dependencies": {
    "@lalternative/nakoda-sdk-browser": "^0.1.0",
    "@lalternative/nakoda-sdk-react": "^0.1.1"
  }
}
